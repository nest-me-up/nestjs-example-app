{
  "name": "@nest-me-up/nestjs-example-app",
  "version": "0.0.1",
  "description": "Example project for a micro-service NestJS based application",
  "main": "dist/main.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "ItaiH",
  "scripts": {
    "build": "tsc",
    "start": "NODE_PATH=./dist node dist/main.js",
    "start:local": "service_config='src/config/local.yml' NODE_ENV=local NODE_PATH=./dist node dist/main.js",
    "dev": "ts-node-dev -r tsconfig-paths/register src/main.ts",
    "dev:debug": "ts-node-dev --inspect=0.0.0.0:9229 -r tsconfig-paths/register src/main.ts",
    "test": "service_config='src/config/test.yml' jest --passWithNoTests --detectOpenHandles --forceExit",
    "test:ci": "service_config='src/config/ci.yml' jest --passWithNoTests --forceExit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:component": "service_config='src/utils/config/test.yml' jest --config test/component/config/jest-component-test.json --runInBand --forceExit --detectOpenHandles",
    "test:component-ci": "service_config='src/utils/config/ci.yml' jest --config test/component/config/jest-component-test.json --runInBand --forceExit",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "migration:generate": "npm run typeorm -- -d src/datasource.ts migration:generate",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- -d src/datasource.ts migration:run",
    "migration:revert": "npm run typeorm -- -d src/datasource.ts migration:revert"
  },
  "keywords": [],
  "dependencies": {
    "@nest-me-up/common": "^1.0.9",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cors": "^2.8.5",
    "express-http-context": "^2.0.1",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.5.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/platform-express": "^10.4.20",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "files": [
    "dist"
  ],
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
